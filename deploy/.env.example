# Copy to deploy/.env and fill in. Never commit deploy/.env (real credentials).

# SSH access to the VPS running Docker + the Caddy reverse proxy.
DEPLOY_SSH_HOST=144.79.249.144
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_PORT=22

# Docker Hub image pulled by deploy/scripts/remote-deploy.sh.
# DEPLOY_TAG is bumped automatically by scripts/docker-publish.sh.
DEPLOY_IMAGE_REPO=shawon1fb/bd-tax-calculator-site
DEPLOY_TAG=latest

# Existing external Docker network shared with the reverse proxy — Caddy reaches
# this container by name over it. Must already exist on the server.
DEPLOY_NETWORK=football-admin-backend-network

# Public URL, only used for the post-deploy hint printed at the end.
DEPLOY_PUBLIC_URL=https://bdtaxcalculator.app
