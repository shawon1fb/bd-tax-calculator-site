# Copy to deploy/.env and fill in. Never commit deploy/.env (real credentials).

# ── Server ──────────────────────────────────────────────────────────────────
# DEPLOY_SSH_USER is the non-root user provision.sh creates; after provisioning
# every other script logs in as that user with your SSH key.
DEPLOY_SSH_HOST=165.99.219.35
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_PORT=22

# Only used by deploy/scripts/provision.sh, on a fresh box, before the deploy
# user exists. Delete it once provisioning has run — and rotate the password.
DEPLOY_PROVISION_USER=root
DEPLOY_ROOT_PASSWORD=

# ── Domain / TLS ────────────────────────────────────────────────────────────
# Needs an A record → DEPLOY_SSH_HOST before Caddy can issue a certificate.
DEPLOY_DOMAIN=taxhelperbd.com
DEPLOY_PUBLIC_URL=https://taxhelperbd.com
DEPLOY_ACME_EMAIL=contact.marufalam@gmail.com

# ── Image ───────────────────────────────────────────────────────────────────
# DEPLOY_TAG is bumped automatically by scripts/docker-publish.sh.
DEPLOY_IMAGE_REPO=shawon1fb/bd-tax-calculator-site
DEPLOY_TAG=latest

# ── Docker ──────────────────────────────────────────────────────────────────
# Network shared by Caddy and the site container. Created automatically if missing.
DEPLOY_NETWORK=bd-tax-network
CADDY_CONTAINER=bd-tax-caddy
